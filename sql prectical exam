WITH MonthlyRevenue AS (
    SELECT 
        DATE_FORMAT(payment_date, '%Y-%m') AS revenue_month,
        SUM(amount) AS monthly_revenue
    FROM Billing
    WHERE payment_status = 'Paid'
    GROUP BY DATE_FORMAT(payment_date, '%Y-%m')
)
SELECT 
    revenue_month,
    monthly_revenue,
    SUM(monthly_revenue) OVER (ORDER BY revenue_month) AS cumulative_revenue
FROM MonthlyRevenue;
WITH DailyAppointments AS (
    SELECT 
        DATE(appointment_date) AS app_date,
        COUNT(*) AS daily_appointments_count
    FROM Appointments
    GROUP BY DATE(appointment_date)
)
SELECT 
    app_date,
    daily_appointments_count,
    SUM(daily_appointments_count) OVER (ORDER BY app_date) AS running_total_appointments
FROM DailyAppointments;
SELECT 
    appointment_id,
    patient_id,
    doctor_id,
    appointment_date,
    status,
    COUNT(*) OVER (ORDER BY appointment_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total
FROM Appointments;
SELECT 
    p.patient_id,
    p.patient_name,
    COUNT(t.treatment_id) AS total_records,
    CASE 
        WHEN COUNT(t.treatment_id) > 5 THEN 'High'
        WHEN COUNT(t.treatment_id) BETWEEN 3 AND 5 THEN 'Medium'
        ELSE 'Low'
    END AS Patient_Risk_Level
FROM Patients p
LEFT JOIN Treatments t ON p.patient_id = t.patient_id
GROUP BY p.patient_id, p.patient_name;
SELECT 
    doctor_id,
    doctor_name,
    specialization,
    experience_years,
    CASE 
        WHEN experience_years > 15 THEN 'Senior'
        WHEN experience_years BETWEEN 5 AND 15 THEN 'Mid-Level'
        ELSE 'Junior'
    END AS Doctor_Category
FROM Doctors;